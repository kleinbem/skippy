+static bool skippy_is_checkpoint_path(const char * path) {
+    std::filesystem::path file(path);
+    std::string name = file.filename().string();
+    std::transform(name.begin(), name.end(), name.begin(),
+            [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    std::error_code error;
+    const auto has_suffix = [&name](std::string_view suffix) {
+        return name.size() >= suffix.size() &&
+                name.compare(name.size() - suffix.size(), suffix.size(), suffix) == 0;
+    };
+    return has_suffix(".safetensors") || has_suffix(".safetensors.index.json") ||
+            std::filesystem::is_directory(file, error);
+}
