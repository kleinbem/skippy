# Every text file checks out with LF on every platform. The repository already
# stores nothing with CRLF, and five host-runtime tests plus the embedded
# Skippy patch-queue digest read files from the working tree byte for byte, so
# a Windows checkout with core.autocrlf=true changed what they saw.
* text=auto eol=lf

# Patch fixtures preserve mail-format signature separators and blank context
# lines byte-for-byte; their trailing spaces are test data, not source style.
scripts/tests/fixtures/rewriter-patch*/** -whitespace

# Authoritative mail patches contain blank diff-context lines and signature
# separators whose spaces are part of the digest-bound patch bytes.
llama_cpp/patches/*.patch -whitespace
llama_cpp/patches/model_support/*.patch -whitespace
llama_cpp/patches/generated/*.patch -whitespace
