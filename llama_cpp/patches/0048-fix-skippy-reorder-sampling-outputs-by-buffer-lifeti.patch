+++ b/src/skippy/tests/sampling_history.cpp
@@ -1032,6 +1032,7 @@ int main(int argc, char ** argv) {
     skippy_error * error = nullptr;
     const auto status = skippy_model_open(argv[1], &config, &model, &error);
     ok(status, error);
+    CHECK(model->ctx->output_reorder_sampler_lifecycle_for_test());
     if (automatic) {
         const auto capabilities = skippy_model_memory_cache_capabilities(model);
         CHECK(capabilities & SKIPPY_MEMORY_CACHE_RESIDENT_ATTENTION);
