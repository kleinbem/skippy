-        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, imatrix_error.c_str());
-        return SKIPPY_STATUS_INVALID_ARGUMENT;
-    }
-
-    ggml_context * tensor_context = nullptr;
-    gguf_init_params init_params = { true, &tensor_context };
