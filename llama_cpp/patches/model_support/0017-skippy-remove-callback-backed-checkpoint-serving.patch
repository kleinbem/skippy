-        if (out_model != nullptr) {
-            *out_model = nullptr;
-        }
-        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "unexpected failure while loading callback tensor source");
-        return SKIPPY_STATUS_RUNTIME_ERROR;
-    }
