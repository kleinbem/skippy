From 93b47b2b8f917d1de748a2ffb0191ee16c6d3a33 Mon Sep 17 00:00:00 2001
From: Skippy CI <ci@skippy.local>
Date: Fri, 20 Nov 2026 08:08:55 +1100
Subject: [PATCH] test-skippy: admit separate resident capability components

---
 tests/test-skippy-kv-page-export.cpp | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/tests/test-skippy-kv-page-export.cpp b/tests/test-skippy-kv-page-export.cpp
index 0fb9f036a..8c109c1e9 100644
--- a/tests/test-skippy-kv-page-export.cpp
+++ b/tests/test-skippy-kv-page-export.cpp
@@ -42,12 +42,15 @@ static bool graph_cache_capabilities_cover_complete_state() {
         });
         return skippy_graph_cache_capabilities(result);
     };
-    const uint32_t dense = SKIPPY_MEMORY_CACHE_RESIDENT | SKIPPY_MEMORY_CACHE_KV_RECURRENT |
+    // Graph admission constrains exporter completeness. The concrete memory
+    // adapter decides which resident components the admitted graph can own.
+    const uint32_t admitted = SKIPPY_MEMORY_CACHE_RESIDENT | SKIPPY_MEMORY_CACHE_RESIDENT_ATTENTION |
+            SKIPPY_MEMORY_CACHE_RESIDENT_CHECKPOINT | SKIPPY_MEMORY_CACHE_KV_RECURRENT |
             SKIPPY_MEMORY_CACHE_FULL_STATE;
-    if (capabilities(skippy_state_kind::kv_key) != dense ||
-            capabilities(skippy_state_kind::kv_value) != dense ||
-            capabilities(skippy_state_kind::recurrent_conv) != (SKIPPY_MEMORY_CACHE_KV_RECURRENT | SKIPPY_MEMORY_CACHE_FULL_STATE) ||
-            capabilities(skippy_state_kind::recurrent_ssm) != (SKIPPY_MEMORY_CACHE_KV_RECURRENT | SKIPPY_MEMORY_CACHE_FULL_STATE) ||
+    if (capabilities(skippy_state_kind::kv_key) != admitted ||
+            capabilities(skippy_state_kind::kv_value) != admitted ||
+            capabilities(skippy_state_kind::recurrent_conv) != admitted ||
+            capabilities(skippy_state_kind::recurrent_ssm) != admitted ||
             capabilities(skippy_state_kind::derived_persistent) != SKIPPY_MEMORY_CACHE_FULL_STATE) {
         return false;
     }
@@ -70,7 +73,7 @@ static bool graph_cache_capabilities_cover_complete_state() {
         {skippy_block_boundary_kind::entry, 0, input},
         {skippy_block_boundary_kind::exit, 0, stateless_output},
     };
-    if (skippy_graph_cache_capabilities(result) != dense) { return false; }
+    if (skippy_graph_cache_capabilities(result) != admitted) { return false; }
 
     // Context-owned cross-attention state is missing even from full memory
     // snapshots. Each input owner declares that fact without a family lookup.
@@ -176,7 +179,8 @@ int main() {
             {});
 
     if (skippy_memory_cache_capabilities(&kv) !=
-            (SKIPPY_MEMORY_CACHE_RESIDENT | SKIPPY_MEMORY_CACHE_KV_RECURRENT | SKIPPY_MEMORY_CACHE_FULL_STATE) ||
+            (SKIPPY_MEMORY_CACHE_RESIDENT | SKIPPY_MEMORY_CACHE_RESIDENT_ATTENTION |
+             SKIPPY_MEMORY_CACHE_KV_RECURRENT | SKIPPY_MEMORY_CACHE_FULL_STATE) ||
             skippy_model_memory_cache_capabilities(nullptr) != 0) {
         return 1;
     }
-- 
2.56.0

