diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 1858847f76c49db2d0ca4e14b061414ba10e0908..57b96a094afce3f30679bb450e52f6ada3033e4c 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -3079,7 +3079,9 @@ void llama_context::output_reorder() {
             }
         }
 
-        if (!sampling.samplers.empty()) {
+        // Samplers may attach or detach after this forward. Permute the
+        // buffers it produced, independently of the current sampler map.
+        if (sampling.sampled.has_data()) {
             assert(sampling.logits.size > 0);
             assert(sampling.probs.size > 0);
             assert(sampling.candidates.size > 0);
diff --git a/src/llama-context.h b/src/llama-context.h
index 020f55b788b2a38208046d6b6bfb02276d604ac4..096b47587b945722a26c818efd4e33db643f9a65 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -123,6 +123,9 @@ struct llama_context {
     const llama_cparams & get_cparams() const;
     const skippy_graph_build_inputs & get_graph_build_inputs() const;
     uint64_t get_sched_reserve_count() const;
+#ifdef LLAMA_STAGE_BUILD_TESTS
+    bool output_reorder_sampler_lifecycle_for_test();
